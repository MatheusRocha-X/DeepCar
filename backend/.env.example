DATABASE_URL=sqlite+aiosqlite:///./deepcar.db
# Render com disco persistente montado em /var/data:
# DATABASE_URL=sqlite+aiosqlite:////var/data/deepcar.db

REDIS_URL=redis://localhost:6379
SECRET_KEY=troque-por-uma-chave-forte
DEBUG=false
ENABLE_SCRAPER=true
ENABLE_SCHEDULER=true
ENABLE_STARTUP_BOOTSTRAP=true
SCRAPER_INTERVAL_MINUTES=60
MAX_PAGES_PER_SOURCE=5

# Local:
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Producao:
# CORS_ORIGINS=["http://localhost:3000","https://seu-projeto.vercel.app"]